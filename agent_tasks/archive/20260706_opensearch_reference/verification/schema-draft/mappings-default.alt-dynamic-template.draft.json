    },
    "docFreq": {
      "type": "long"
    },
    "userBoost": {
      "type": "double"
    },
    "kinds": {
      "type": "keyword"
    },
    "tags": {
      "type": "keyword"
    },
    "roles": {
      "type": "keyword"
    },
    "languages": {
      "type": "keyword"
    },
    "fields": {
      "type": "keyword"
    },
    "embedding": {
      "type": "knn_vector",
      "dimension": 4,
      "space_type": "cosinesimil",
      "method": {
        "name": "hnsw",
        "engine": "lucene",
        "parameters": {
          "ef_construction": 100,
          "m": 16
        }
      }
    }
  }
