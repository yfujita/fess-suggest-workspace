{
  "settings": {
    "index": {
      "refresh_interval": "10s",
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "auto_expand_replicas": "0-1"
    }
  },
  "mappings": {
    "dynamic_templates": [
      {
        "strings": {
          "match": "*",
          "match_mapping_type": "string",
          "mapping": { "type": "keyword" }
        }
      }
    ],
    "properties": {
      "@timestamp": { "type": "date", "format": "epoch_millis" },
      "docFreq": { "type": "long" },
      "queryFreq": { "type": "long" },
      "userBoost": { "type": "double" },
      "score": { "type": "double" },
      "text": { "type": "keyword" },
      "kinds": { "type": "keyword" },
      "tags": { "type": "keyword" },
      "roles": { "type": "keyword" },
      "languages": { "type": "keyword" },
      "fields": { "type": "keyword" }
    }
  }
}
